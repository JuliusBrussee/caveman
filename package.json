{
  "name": "sweet-agent",
  "version": "4.1.0",
  "description": "Sweet Agent: concise casual Korean replies with technical accuracy intact.",
  "license": "Apache-2.0",
  "author": "HDomi",
  "homepage": "https://github.com/HDomi/sweet-agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HDomi/sweet-agent.git"
  },
  "bugs": {
    "url": "https://github.com/HDomi/sweet-agent/issues"
  },
  "bin": {
    "sweet-agent": "./installer/sweet.js",
    "sweet": "./installer/sweet.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test --test-force-exit --test-concurrency=2 tests/installer/*.test.mjs tests/hooks/*.test.mjs",
    "test:windows": "node scripts/test-windows-compat.mjs",
    "sync:sweet": "node packages/cli/scripts/compile-registries.mjs && node scripts/sync-sweet.mjs"
  },
  "files": [
    ".cursor-plugin/",
    "installer/",
    ".codex/codex-sessionstart.js",
    "hooks/",
    "src/",
    "agents/",
    "skills/",
    "plugins/",
    "commands/",
    "dist/caveman.skill",
    "README.md",
    "LICENSE",
    "NOTICE",
    "!**/__pycache__/**",
    "!**/*.py[cod]",
    "dist/sweet.skill",
    ".claude-plugin/",
    "gemini-extension.json",
    "GEMINI.md"
  ],
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@caveman-ai/cli": "^4.0.0"
  }
}
