{
  "schema_version": "1",
  "id": "kilo",
  "display_name": "Kilo Code",
  "vendor": "Kilo Code",
  "homepage": "https://kilo.ai/docs/code-with-ai/platforms/cli",
  "binary_names": [
    "kilo",
    "kilocode"
  ],
  "args": [],
  "install": "npm install -g @kilocode/cli@7.8.18",
  "wire_protocol": "openai-chat",
  "injection": {
    "method": "config-env-content",
    "env_var": "KILO_CONFIG_CONTENT",
    "config_content": {
      "local": {
        "provider": {
          "caveman": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Caveman Local Proxy",
            "options": {
              "baseURL": "{{cave_base_url}}/v1",
              "apiKey": "{env:OPENAI_API_KEY}",
              "headers": {
                "X-Cave-Agent": "kilo"
              }
            },
            "models": {
              "gpt-5.5": {
                "name": "GPT-5.5 (via Caveman)",
                "tool_call": true,
                "limit": {
                  "context": 1050000,
                  "output": 32768
                }
              },
              "gpt-5.4-mini": {
                "name": "GPT-5.4 mini (via Caveman)",
                "tool_call": true,
                "limit": {
                  "context": 400000,
                  "output": 16384
                }
              }
            }
          }
        },
        "model": "caveman/gpt-5.5",
        "enabled_providers": [
          "caveman"
        ]
      },
      "managed": {
        "provider": {
          "caveman": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Caveman Gateway",
            "options": {
              "baseURL": "{{cave_base_url}}/v1",
              "apiKey": "{env:CAVE_API_KEY}",
              "headers": {
                "x-cave-upstream-key": "{{cave_optional_openai_key_env}}",
                "X-Cave-Agent": "kilo"
              }
            },
            "models": {
              "gpt-5.5": {
                "name": "GPT-5.5 (via Caveman)",
                "tool_call": true,
                "limit": {
                  "context": 1050000,
                  "output": 32768
                }
              },
              "gpt-5.4-mini": {
                "name": "GPT-5.4 mini (via Caveman)",
                "tool_call": true,
                "limit": {
                  "context": 400000,
                  "output": 16384
                }
              }
            }
          }
        },
        "model": "caveman/gpt-5.5",
        "enabled_providers": [
          "caveman"
        ]
      }
    }
  },
  "attribution": {
    "header": "X-Cave-Agent"
  },
  "tested_agent_version": "7.8.18",
  "injection_completeness": "declarative",
  "last_verified_at": "2026-10-27",
  "verified_by": "local pinned-binary probe (kilo 7.8.18 on Linux x86_64 with Node 24.16.0, agents/probe-installed.mjs: --version and --help both exit 0); two route probes from separate scratch homes and different loopback ports: this profile's own KILO_CONFIG_CONTENT local overlay made `kilo run --pure --format json` send POST /v1/chat/completions at the injected baseURL carrying X-Cave-Agent: kilo and the dummy OPENAI_API_KEY as Authorization: Bearer (model gpt-5.5, stream: true), receive the scripted SSE reply, and complete (exit 0). The model came from the profile, without a CLI model override. The overlay was rendered from the profile by hand rather than through the CLI's buildWrapEnv, so its base-config merge was not exercised; external plugins were disabled with --pure. No live provider or compression was tested",
  "fallback": "generic-env",
  "maintainer": null
}
