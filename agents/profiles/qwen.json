{
  "schema_version": "1",
  "id": "qwen",
  "display_name": "Qwen Code",
  "vendor": "QwenLM",
  "homepage": "https://github.com/QwenLM/qwen-code",
  "binary_names": ["qwen"],
  "args": ["--extensions=none"],
  "install": "npm i -g @qwen-code/qwen-code@0.22.3",
  "wire_protocol": "openai-chat",
  "injection": {
    "method": "config-file",
    "env_var": "QWEN_CODE_SYSTEM_SETTINGS_PATH",
    "base_config": {
      "path": "~/.qwen/system-settings.json",
      "env_var": "QWEN_CODE_SYSTEM_SETTINGS_PATH",
      "platform_default": "qwen-system-settings"
    },
    "config_overlay": {
      "local": {
        "providerProtocol": {},
        "modelProviders": {
          "openai": [
            {
              "id": "gpt-5.5",
              "name": "GPT-5.5 (via Caveman)",
              "envKey": "OPENAI_API_KEY",
              "baseUrl": "{{cave_base_url}}/v1",
              "generationConfig": {
                "customHeaders": { "X-Cave-Agent": "qwen" }
              }
            },
            {
              "id": "gpt-5.4-mini",
              "name": "GPT-5.4 mini (via Caveman)",
              "envKey": "OPENAI_API_KEY",
              "baseUrl": "{{cave_base_url}}/v1",
              "generationConfig": {
                "customHeaders": { "X-Cave-Agent": "qwen" }
              }
            }
          ]
        },
        "security": { "auth": { "selectedType": "openai", "enforcedType": "openai" } },
        "model": { "name": "gpt-5.5", "baseUrl": "{{cave_base_url}}/v1" },
        "modelFallbacks": "",
        "fastModel": "",
        "advisorModel": "",
        "visionModel": "",
        "compactionModel": "",
        "imageModel": "",
        "voiceModel": "",
        "disableAllHooks": true,
        "tools": {
          "webSearch": { "enabled": false, "model": "" },
          "workflowsEnabled": false,
          "disabled": ["agent", "skill", "web_search", "create_sub_session", "workflow"]
        },
        "agents": { "builtin": { "exploreModel": "inherit" }, "allowedGrades": [] },
        "permissions": { "deny": ["Agent", "Skill", "WebSearch", "CreateSubSession", "Workflow"] },
        "skills": { "disabledLevels": ["project", "user", "extension", "bundled"] },
        "experimental": { "liveVoice": { "enabled": false, "apiKey": "", "model": "" } },
        "slashCommands": {
          "disabled": [
            "auth", "connect", "login", "model", "arena", "agents", "workflows",
            "settings", "config", "permissions", "skills", "voice", "extensions", "reload-plugins",
            "hooks", "mcp", "resume", "continue", "import-config"
          ]
        }
      },
      "managed": {
        "providerProtocol": {},
        "modelProviders": {
          "openai": [
            {
              "id": "gpt-5.5",
              "name": "GPT-5.5 (via Caveman)",
              "envKey": "CAVE_API_KEY",
              "baseUrl": "{{cave_base_url}}/v1",
              "generationConfig": {
                "customHeaders": {
                  "x-cave-upstream-key": "{{cave_optional_openai_key_env}}",
                  "X-Cave-Agent": "qwen"
                }
              }
            },
            {
              "id": "gpt-5.4-mini",
              "name": "GPT-5.4 mini (via Caveman)",
              "envKey": "CAVE_API_KEY",
              "baseUrl": "{{cave_base_url}}/v1",
              "generationConfig": {
                "customHeaders": {
                  "x-cave-upstream-key": "{{cave_optional_openai_key_env}}",
                  "X-Cave-Agent": "qwen"
                }
              }
            }
          ]
        },
        "security": { "auth": { "selectedType": "openai", "enforcedType": "openai" } },
        "model": { "name": "gpt-5.5", "baseUrl": "{{cave_base_url}}/v1" },
        "modelFallbacks": "",
        "fastModel": "",
        "advisorModel": "",
        "visionModel": "",
        "compactionModel": "",
        "imageModel": "",
        "voiceModel": "",
        "disableAllHooks": true,
        "tools": {
          "webSearch": { "enabled": false, "model": "" },
          "workflowsEnabled": false,
          "disabled": ["agent", "skill", "web_search", "create_sub_session", "workflow"]
        },
        "agents": { "builtin": { "exploreModel": "inherit" }, "allowedGrades": [] },
        "permissions": { "deny": ["Agent", "Skill", "WebSearch", "CreateSubSession", "Workflow"] },
        "skills": { "disabledLevels": ["project", "user", "extension", "bundled"] },
        "experimental": { "liveVoice": { "enabled": false, "apiKey": "", "model": "" } },
        "slashCommands": {
          "disabled": [
            "auth", "connect", "login", "model", "arena", "agents", "workflows",
            "settings", "config", "permissions", "skills", "voice", "extensions", "reload-plugins",
            "hooks", "mcp", "resume", "continue", "import-config"
          ]
        }
      }
    }
  },
  "attribution": { "header": "X-Cave-Agent" },
  "tested_agent_version": "0.22.3",
  "injection_completeness": "declarative",
  "last_verified_at": "2026-08-30",
  "verified_by": "local pinned-binary route probe (@qwen-code/qwen-code 0.22.3)",
