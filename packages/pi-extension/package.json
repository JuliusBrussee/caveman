{
  "name": "@caveman-ai/pi",
  "version": "0.2.0",
  "description": "Native Caveman extension for Pi and Oh My Pi \u2014 proxy routing, exact-recovery caveman_retrieve tool, native lifecycle events, Core injection, and tool-output shrinking.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuliusBrussee/caveman.git",
    "directory": "packages/pi-extension"
  },
  "homepage": "https://getcaveman.dev",
  "keywords": [
    "pi-package",
    "caveman"
  ],
  "pi": {
    "extensions": [
      "./dist/index.mjs"
    ]
  },
  "omp": {
    "extensions": [
      "./dist/omp.mjs"
    ]
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist/index.mjs",
    "dist/omp.mjs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc --noEmit && node scripts/bundle.mjs",
    "lint": "tsc --noEmit",
    "prepack": "npm run build",
    "test": "npm run build && node --test --test-force-exit tests/protocol.runtime.mjs tests/provider.runtime.mjs tests/provider-compat.runtime.mjs tests/recovery.runtime.mjs tests/portable-command.runtime.mjs tests/runtime.runtime.mjs tests/integration.runtime.mjs",
    "test:omp": "npm run build && bun test tests/omp.runtime.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@oh-my-pi/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@oh-my-pi/pi-coding-agent": { "optional": true },
    "typebox": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@oh-my-pi/pi-coding-agent": "^18.1.17",
    "@types/node": "24.10.1",
    "esbuild": "0.28.1",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  },
  "overrides": {
    "sharp": "0.35.4",
    "adm-zip": "0.6.1"
  }
}
