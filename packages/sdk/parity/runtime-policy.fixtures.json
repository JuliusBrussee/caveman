    { "keys": ["proj-a", "exp-2", ""], "fraction": 0.43062198340003566, "holdout_frac": 0.25, "arms": [{ "name": "candidate", "fraction": 3 }, { "name": "alt", "fraction": 1 }], "expected_arm": "candidate", "expected_propensity": 0.5625 },
