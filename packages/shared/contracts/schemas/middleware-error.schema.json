{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/JuliusBrussee/caveman/main/packages/shared/contracts/schemas/middleware-error.schema.json",
  "title": "Caveman middleware error envelope",
  "description": "Every non-2xx middleware response. The code catalog and status mapping live in docs/technical/middleware-protocol.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "$ref": "https://raw.githubusercontent.com/JuliusBrussee/caveman/main/packages/shared/contracts/schemas/middleware-common.schema.json#/$defs/reason"
        }
      }
    }
  }
}
