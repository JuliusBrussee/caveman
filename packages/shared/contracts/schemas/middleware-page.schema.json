{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/JuliusBrussee/caveman/contracts-v2.0.0/packages/shared/contracts/schemas/middleware-page.schema.json",
  "title": "Caveman middleware retrieve page",
  "description": "retrieve 200 response. Closed on purpose: describes exactly what a protocol 1.1 server emits, and the conformance kit holds servers to it. Clients MUST NOT validate responses against this schema; they ignore unknown fields (docs/technical/middleware-protocol.md §4, §16).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handle",
    "source_id",
    "text",
    "original_sha256",
    "total_bytes",
    "complete",
    "kind",
    "offset",
    "next_offset"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "handle": {
      "$ref": "middleware-common.schema.json#/$defs/token"
    },
    "source_id": {
      "$ref": "middleware-common.schema.json#/$defs/token"
    },
    "text": {
      "type": "string",
      "maxLength": 262144
    },
    "original_sha256": {
      "$ref": "middleware-common.schema.json#/$defs/sha256"
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "complete": {
      "type": "boolean"
    },
    "kind": {
      "enum": [
        "original_page",
        "excerpt"
      ]
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "next_offset": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
