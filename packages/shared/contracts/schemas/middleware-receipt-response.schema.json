{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/JuliusBrussee/caveman/main/packages/shared/contracts/schemas/middleware-receipt-response.schema.json",
  "title": "Caveman middleware receipts response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "basis",
    "verified_saved_usd"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "recorded"
    },
    "basis": {
      "const": "client_observed"
    },
    "verified_saved_usd": {
      "const": 0
    }
  }
}
