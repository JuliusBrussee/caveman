{
  "family": "caveman-proxy",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::REPLACE_ACCOUNT_ID:role/REPLACE_ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::REPLACE_ACCOUNT_ID:role/REPLACE_caveman_proxy_task_role_with_bedrock_InvokeModel",
  "volumes": [
    {
      "name": "caveman-data"
    }
  ],
  "containerDefinitions": [
    {
      "name": "caveman-proxy",
      "image": "ghcr.io/juliusbrussee/caveman-proxy:bin-v2.0.0",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8787,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "REPLACE_REGION"
        },
        {
          "name": "CAVEMAN_MODE",
          "value": "record"
        },
        {
          "name": "CAVEMAN_MIDDLEWARE_MODE",
          "value": "compress"
        }
      ],
      "secrets": [
        {
          "name": "CAVEMAN_AUTH_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:REPLACE_REGION:REPLACE_ACCOUNT_ID:secret:caveman-proxy/auth-token-REPLACE_SUFFIX"
        },
        {
          "name": "CAVEMAN_MIDDLEWARE_DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:REPLACE_REGION:REPLACE_ACCOUNT_ID:secret:caveman-proxy/middleware-database-url-REPLACE_SUFFIX"
        },
        {
          "name": "CAVEMAN_MIDDLEWARE_ENCRYPTION_KEY",
          "valueFrom": "arn:aws:secretsmanager:REPLACE_REGION:REPLACE_ACCOUNT_ID:secret:caveman-proxy/middleware-encryption-key-REPLACE_SUFFIX"
        },
        {
          "name": "CAVE_POSTGRES_CA_CERT",
          "valueFrom": "arn:aws:secretsmanager:REPLACE_REGION:REPLACE_ACCOUNT_ID:secret:caveman-proxy/rds-ca-bundle-REPLACE_SUFFIX"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "caveman-data",
          "containerPath": "/data",
          "readOnly": false
        }
      ],
      "user": "65532:65532",
      "readonlyRootFilesystem": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/caveman-proxy",
          "awslogs-region": "REPLACE_REGION",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
